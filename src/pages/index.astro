---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import PostCard from '../components/PostCard.astro';
import GenArt from '../components/GenArt.astro';
import { SITE } from '../site.config';
import { sortPosts } from '../lib/utils';

const posts = sortPosts(await getCollection('blog'));
const [featured, ...rest] = posts;
const recent = rest.slice(0, 4);
const tagCount = new Set(posts.flatMap((p) => p.data.tags)).size;

const phrases = [
  '生成艺术 · GENERATIVE ART',
  '算法与美学 · ALGORITHM × AESTHETIC',
  '构建记录 · BUILD LOG',
];
---

<BaseLayout>
  <section class="relative flex min-h-[86svh] items-center overflow-hidden">
    <HeroCanvas />
    <div class="aurora"></div>
    <div class="grid-lines"></div>
    <div class="wrap relative z-10 py-24">
      <p
        class="font-mono text-xs sm:text-sm text-muted"
        data-reveal
      >
        <span class="text-accent">~/</span>{SITE.title.toLowerCase()}
        <span class="text-faint">$</span> whoami
      </p>
      <h1 class="mt-6 select-none leading-[0.92]" data-reveal>
        <span
          class="block font-mono font-bold tracking-tight text-[15.5vw] sm:text-8xl md:text-9xl"
        >CODE</span>
        <span
          class="block font-display italic text-aurora text-[13vw] sm:text-7xl md:text-8xl mt-1 pr-2"
        >as art<span
            class="font-mono text-accent text-[0.42em] align-baseline blink"
            aria-hidden="true">▊</span
          ></span
        >
      </h1>
      <p
        class="mt-8 h-6 font-mono text-xs sm:text-sm text-muted"
        data-reveal
        aria-hidden="true"
      >
        <span
          id="typed"
          data-phrases={JSON.stringify(phrases)}
        ></span><span class="text-accent blink">_</span>
      </p>
      <div
        class="mt-10 flex flex-wrap gap-x-10 gap-y-3 font-mono text-[11px] tracking-widest text-muted"
        data-reveal
      >
        <span><span class="text-faint">POSTS</span> {posts.length}</span>
        <span><span class="text-faint">TAGS</span> {tagCount}</span>
        <a href="/about" class="u-link">ABOUT ME →</a>
        <a href="/rss.xml" class="u-link">RSS FEED →</a>
      </div>
    </div>
    <span
      class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 font-mono text-[10px] tracking-[0.3em] text-faint animate-bounce"
      aria-hidden="true">SCROLL ▾</span
    >
  </section>

  <section class="wrap pt-20">
    <div class="flex items-end justify-between border-b border-line pb-4">
      <h2 class="font-mono text-sm tracking-[0.25em]" data-reveal>
        RECENT.POSTS<span class="text-accent">_</span>
      </h2>
      <a href="/blog/" class="u-link font-mono text-[11px] text-muted" data-reveal>
        VIEW ALL ({posts.length}) →
      </a>
    </div>

    {
      featured && (
        <div class="mt-12">
          <PostCard post={featured} variant="featured" index={0} />
        </div>
      )
    }

    <div class="mt-14">
      {recent.map((post, i) => (
        <PostCard post={post} variant="row" index={i + 1} />
      ))}
    </div>
  </section>

  <section class="wrap pt-24">
    <div class="border-b border-line pb-4" data-reveal>
      <h2 class="font-mono text-sm tracking-[0.25em]">
        EVERY.COVER.IS.UNIQUE<span class="text-accent">_</span>
      </h2>
    </div>
    <a href="/blog/code-as-art/" class="group mt-10 block" data-reveal>
      <GenArt seed={`${SITE.title}-showcase`} class="aspect-[21/9] rounded-xl" />
      <p class="mt-4 font-mono text-[11px] text-muted transition-colors group-hover:text-accent">
        ▲ 本站所有封面均由流场算法根据标题种子实时生成 —— 每篇文章都有独一无二的画。点击了解原理 →
      </p>
    </a>
  </section>

  <script>
    let timer: ReturnType<typeof setTimeout> | undefined;

    function initTyped() {
      clearTimeout(timer);
      const el = document.getElementById('typed');
      let phrases: string[] = [];
      try {
        phrases = JSON.parse(el?.dataset.phrases ?? '[]');
      } catch {}
      if (!el || !phrases.length) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        el.textContent = phrases[0];
        return;
      }
      let pi = 0;
      let ci = 0;
      let deleting = false;
      const step = () => {
        const cur = phrases[pi];
        ci += deleting ? -1 : 1;
        el.textContent = cur.slice(0, ci);
        let delay = deleting ? 38 : 88;
        if (!deleting && ci === cur.length) {
          delay = 2200;
          deleting = true;
        } else if (deleting && ci === 0) {
          deleting = false;
          pi = (pi + 1) % phrases.length;
          delay = 420;
        }
        timer = setTimeout(step, delay);
      };
      step();
    }

    initTyped();
    document.addEventListener('astro:page-load', initTyped);
    document.addEventListener('astro:before-swap', () => clearTimeout(timer));
  </script>
</BaseLayout>

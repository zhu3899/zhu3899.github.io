---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { sortPosts, groupByYear } from '../../lib/utils';

const posts = sortPosts(await getCollection('blog'));
const groups = groupByYear(posts);
---

<BaseLayout
  title="文章"
  description="全部文章列表"
>
  <div class="wrap pt-16 sm:pt-20">
    <h1
      class="font-display text-4xl sm:text-6xl font-semibold tight-cn"
      data-reveal
    >
      文章
    </h1>
    <p class="mt-4 font-mono text-xs text-muted" data-reveal>
      <span class="text-faint">$</span> ls -la ~/posts |
      <span class="text-accent">wc -l</span> → {posts.length}
    </p>

    <div class="rule-double mt-10" data-reveal></div>

    {
      groups.map(([year, yearPosts]) => (
        <section class="mt-20">
          <div class="flex items-baseline gap-5">
            <span class="font-display italic text-aurora text-6xl sm:text-7xl font-semibold select-none">
              {year}
            </span>
            <span class="font-mono text-[10px] tracking-[0.25em] text-faint">
              {yearPosts.length} 篇
            </span>
          </div>
          <div class="mt-12 grid gap-x-10 gap-y-14 sm:grid-cols-2">
            {yearPosts.map((post, i) => (
              <PostCard post={post} variant="card" index={i} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

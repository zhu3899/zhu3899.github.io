---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortPosts } from '../../lib/utils';

const posts = sortPosts(await getCollection('blog'));
const counts = new Map<string, number>();
for (const p of posts) {
  for (const t of p.data.tags) {
    counts.set(t, (counts.get(t) ?? 0) + 1);
  }
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="标签" description="全部标签">
  <div class="wrap pt-12 sm:pt-16">
    <h1 class="font-mono text-4xl sm:text-6xl font-bold tracking-tight" data-reveal>
      TAGS<span class="text-accent">_</span>
    </h1>
    <p class="mt-4 font-mono text-xs text-muted" data-reveal>
      <span class="text-faint">$</span> find ~/posts -name "*.md" | xargs grep
      -h "^tags" | sort | uniq -c
    </p>
    <div class="mt-12 flex flex-wrap gap-3">
      {
        tags.map(([tag, n]) => (
          <a href={`/tags/${tag}/`} class="chip !text-xs px-4 py-1.5">
            #{tag}
            <sup class="ml-1 text-accent">{n}</sup>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

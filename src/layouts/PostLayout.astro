---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import Giscus from '../components/Giscus.astro';
import { formatDate, readingTime } from '../lib/utils';

interface Neighbor {
  id: string;
  title: string;
}

interface Props {
  post: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
  prev?: Neighbor;
  next?: Neighbor;
}

const { post, headings, prev, next } = Astro.props;
const minutes = readingTime(post.body ?? '');
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="progress-bar" aria-hidden="true"></div>

  <article class="wrap pt-16 sm:pt-20 pb-4" data-pagefind-body>
    <a href="/blog/" class="u-link font-mono text-xs text-muted" data-pagefind-ignore>
      ‹‹ BLOG
    </a>

    <h1
      class="mt-8 font-display text-4xl sm:text-6xl font-semibold leading-[1.14] tight-cn"
      data-reveal
      data-pagefind-meta="title"
      data-pagefind-weight="10"
    >
      {post.data.title}
    </h1>

    <div
      class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs text-muted"
      data-reveal
    >
      <span class="text-accent">{formatDate(post.data.pubDate)}</span>
      {
        post.data.updatedDate && (
          <span class="text-faint">
            更新于 {formatDate(post.data.updatedDate)}
          </span>
        )
      }
      <span>~{minutes} MIN</span>
      {
        post.data.tags.map((t) => (
          <a href={`/tags/${t}/`} class="chip">
            #{t}
          </a>
        ))
      }
    </div>

    <div class="rule-double mt-10" data-reveal></div>

    <details
      class="lg:hidden mt-8 border border-line rounded-lg px-4 py-3"
      data-reveal
      data-pagefind-ignore
    >
      <summary
        class="cursor-pointer font-mono text-[10px] tracking-[0.25em] text-muted select-none"
      >
        目录
      </summary>
      <div class="mt-4">
        <Toc headings={headings} />
      </div>
    </details>

    <div class="mt-12 lg:grid lg:grid-cols-[minmax(0,1fr)_200px] lg:gap-16">
      <div class="prose prose-headings:scroll-mt-24 drop-cap min-w-0">
        <slot />
      </div>
      <aside class="hidden lg:block" data-pagefind-ignore>
        <div class="sticky top-20 max-h-[calc(100vh-7rem)] overflow-y-auto pr-2">
          <Toc headings={headings} />
        </div>
      </aside>
    </div>

    <div class="mt-20 flex justify-end" data-reveal data-pagefind-ignore>
      <span class="seal text-lg">記</span>
    </div>

    <hr class="hairline mt-10" />

    <nav
      class="mt-10 grid gap-px sm:grid-cols-2 sm:gap-8"
      aria-label="上下篇"
      data-pagefind-ignore
    >
      {
        next ? (
          <a href={`/blog/${next.id}/`} class="group min-w-0">
            <span class="font-mono text-[10px] tracking-[0.25em] text-faint">
              ← 上一篇
            </span>
            <p class="mt-1.5 font-display text-lg leading-snug tight-cn transition-colors group-hover:text-accent">
              {next.title}
            </p>
          </a>
        ) : (
          <span />
        )
      }
      {
        prev && (
          <a href={`/blog/${prev.id}/`} class="group min-w-0 sm:text-right">
            <span class="font-mono text-[10px] tracking-[0.25em] text-faint">
              下一篇 →
            </span>
            <p class="mt-1.5 font-display text-lg leading-snug tight-cn transition-colors group-hover:text-accent">
              {prev.title}
            </p>
          </a>
        )
      }
    </nav>

    <Giscus />
  </article>
</BaseLayout>

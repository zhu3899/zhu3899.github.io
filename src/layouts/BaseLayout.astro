---
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/instrument-serif';
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/600.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <BaseHead title={title} description={description} />
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <SearchDialog />

    <script>
      // ── reveal choreography ──────────────────────────────────
      let io: IntersectionObserver | null = null;

      function initReveal() {
        io?.disconnect();
        io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                io?.unobserve(entry.target);
              }
            }
          },
          { threshold: 0, rootMargin: '0px 0px -10% 0px' }
        );
        document
          .querySelectorAll<HTMLElement>('[data-reveal]')
          .forEach((el, i) => {
            if (!el.style.getPropertyValue('--reveal-delay')) {
              el.style.setProperty(
                '--reveal-delay',
                `${Math.min(i * 60, 360)}ms`
              );
            }
            io?.observe(el);
          });
      }

      // ── copy buttons on code windows ─────────────────────────
      function initCopyButtons() {
        document.querySelectorAll('pre').forEach((pre) => {
          if (pre.querySelector('.copy-btn')) return;
          const code = pre.innerText.replace(/\n$/, '');
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'copy-btn';
          btn.textContent = 'COPY';
          btn.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(code);
              btn.textContent = 'DONE ✓';
            } catch {
              btn.textContent = 'FAILED ✕';
            }
            setTimeout(() => (btn.textContent = 'COPY'), 1500);
          });
          pre.appendChild(btn);
        });
      }

      // ── reading progress bar ─────────────────────────────────
      let progressRaf = 0;
      function initProgress() {
        const bar = document.querySelector<HTMLElement>('.progress-bar');
        if (!bar) return;
        const update = () => {
          const doc = document.documentElement;
          const max = doc.scrollHeight - innerHeight;
          bar.style.setProperty(
            '--progress',
            max > 0 ? String(Math.min(scrollY / max, 1)) : '0'
          );
        };
        const onScroll = () => {
          cancelAnimationFrame(progressRaf);
          progressRaf = requestAnimationFrame(update);
        };
        if (!bar.dataset.bound) {
          bar.dataset.bound = '1';
          addEventListener('scroll', onScroll, { passive: true });
          addEventListener('resize', onScroll, { passive: true });
        }
        update();
      }

      // ── toc scrollspy ────────────────────────────────────────
      let spy: IntersectionObserver | null = null;
      function initScrollSpy() {
        spy?.disconnect();
        const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
        if (!links.length) return;
        const map = new Map<string, HTMLAnchorElement>();
        links.forEach((l) => {
          const id = decodeURIComponent(l.hash.slice(1));
          if (id) map.set(id, l);
        });
        const headings = document.querySelectorAll(
          '.prose h2[id], .prose h3[id]'
        );
        if (!headings.length) return;
        spy = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              links.forEach((l) => l.classList.remove('is-active'));
              const link = map.get(entry.target.id);
              if (link) link.classList.add('is-active');
            }
          },
          { rootMargin: '-15% 0px -70% 0px', threshold: 0 }
        );
        headings.forEach((h) => spy?.observe(h));
      }

      const initAll = () => {
        initReveal();
        initCopyButtons();
        initProgress();
        initScrollSpy();
      };

      document.addEventListener('astro:page-load', initAll);
      document.addEventListener('astro:before-swap', () => {
        io?.disconnect();
        spy?.disconnect();
        cancelAnimationFrame(progressRaf);
      });
    </script>
  </body>
</html>

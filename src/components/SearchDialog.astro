---
---

<div id="search-overlay" class="search-overlay" hidden>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="搜索文章">
    <div class="search-input-row">
      <span class="text-accent font-mono select-none">❯</span>
      <input
        id="search-input"
        type="text"
        placeholder="搜索文章…"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd>ESC</kbd>
    </div>
    <ul id="search-results" class="search-results max-h-[52vh] overflow-y-auto" />
    <p id="search-empty" class="hidden px-5 py-8 text-center font-mono text-xs text-muted" />
    <div
      class="flex items-center justify-between border-t border-line px-4 py-2.5 font-mono text-[10px] tracking-widest text-faint"
    >
      <span>↑↓ SELECT · ↵ OPEN</span>
      <span>POWERED BY PAGEFIND</span>
    </div>
  </div>
</div>

<script>
  interface SearchCtx {
    overlay: HTMLElement;
    input: HTMLInputElement;
    list: HTMLElement;
    empty: HTMLElement;
    selIndex: number;
    debounce?: ReturnType<typeof setTimeout>;
  }

  let pagefind: any = null;
  let ctx: SearchCtx | null = null;

  function dynamicImport(url: string): Promise<any> {
    return new Function('u', 'return import(u)')(url);
  }

  function showEmpty(msg?: string) {
    if (!ctx) return;
    ctx.empty.textContent =
      msg ?? `未找到与 “${ctx.input.value}” 相关的文章`;
    ctx.empty.classList.remove('hidden');
  }

  async function ensurePagefind() {
    if (pagefind || !ctx) return;
    try {
      pagefind = await dynamicImport(
        new URL('/pagefind/pagefind.js', window.location.origin).href
      );
    } catch (err) {
      console.error('[search] Pagefind 加载失败:', err);
      showEmpty('搜索暂时不可用，请刷新重试');
    }
  }

  async function run() {
    if (!ctx || !ctx.input.value.trim() || !pagefind) return;
    let res;
    let data;
    try {
      res = await pagefind.search(ctx.input.value);
      data = await Promise.all(
        res.results.slice(0, 8).map((r: any) => r.data())
      );
    } catch (err) {
      console.error('[search] 搜索出错:', err);
      showEmpty('搜索出错，请重试');
      return;
    }
    ctx.list.innerHTML = '';
    ctx.selIndex = -1;
    ctx.empty.classList.toggle('hidden', data.length > 0);
    if (!data.length) showEmpty();
    for (const d of data) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = d.url;
      const title = document.createElement('div');
      title.className = 'sr-title';
      title.textContent = d.meta?.title ?? d.url;
      const excerpt = document.createElement('div');
      excerpt.className = 'sr-excerpt';
      excerpt.innerHTML = d.excerpt ?? '';
      a.append(title, excerpt);
      li.append(a);
      ctx.list.append(li);
    }
  }

  function open() {
    if (!ctx) return;
    ctx.overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    ctx.input.value = '';
    ctx.list.innerHTML = '';
    ctx.selIndex = -1;
    ctx.input.focus();
    ensurePagefind();
  }

  function close() {
    if (!ctx) return;
    ctx.overlay.hidden = true;
    document.body.style.overflow = '';
  }

  function initSearch() {
    const overlay = document.getElementById('search-overlay');
    const input = document.getElementById(
      'search-input'
    ) as HTMLInputElement | null;
    const list = document.getElementById('search-results');
    const empty = document.getElementById('search-empty');
    if (!overlay || !input || !list || !empty) return;

    ctx = { overlay, input, list, empty, selIndex: -1 };

    if (!(window as any).__searchGlobalBound) {
      (window as any).__searchGlobalBound = true;
      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (!ctx?.overlay.hidden) close();
          else open();
        }
      });
      document.addEventListener('keydown', (e) => {
        if (!ctx || ctx.overlay.hidden) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          const items = [...ctx.list.querySelectorAll('li')];
          if (!items.length) return;
          items[ctx.selIndex]?.querySelector('a')?.classList.remove('is-sel');
          ctx.selIndex =
            (ctx.selIndex + (e.key === 'ArrowDown' ? 1 : -1) + items.length) %
            items.length;
          const a = items[ctx.selIndex].querySelector('a');
          a?.classList.add('is-sel');
          a?.scrollIntoView({ block: 'nearest' });
        }
        if (e.key === 'Enter' && ctx.selIndex >= 0) {
          const a = ctx.list
            .querySelectorAll('li')
            [ctx.selIndex]?.querySelector('a');
          (a as HTMLAnchorElement | null)?.click();
        }
      });
    }

    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });

    document
      .querySelectorAll('[data-search-open]')
      .forEach((btn) => btn.addEventListener('click', open));

    input.addEventListener('input', () => {
      if (!ctx) return;
      clearTimeout(ctx.debounce);
      ctx.debounce = setTimeout(run, 120);
    });
  }

  initSearch();
  document.addEventListener('astro:page-load', initSearch);
</script>

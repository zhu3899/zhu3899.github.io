---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../lib/utils';

interface Props {
  post: CollectionEntry<'blog'>;
  variant?: 'row' | 'card' | 'featured';
  index?: number;
}

const { post, variant = 'row', index = 0 } = Astro.props;
const href = `/blog/${post.id}/`;
const delay = `--reveal-delay:${Math.min(index * 60, 360)}ms`;
const minutes = readingTime(post.body ?? '');
const tags = post.data.tags.map((t) => `#${t}`).join(' ');

/* 序号用汉字 —— 这是排版里最容易带出东方味的一处 */
const CN = ['一', '二', '三', '四', '五', '六', '七', '八', '九', '十'];
const cn = (n: number) => CN[n - 1] ?? String(n);
---

{
  variant === 'featured' && (
    <a href={href} class="group block" data-reveal style={delay}>
      <div class="rule-double" />
      <div class="mt-9 flex items-baseline gap-6">
        <span class="hidden sm:block shrink-0 font-display italic text-3xl text-faint select-none leading-none">
          {cn(index + 1)}
        </span>
        <div class="min-w-0">
          <h3 class="font-display text-3xl sm:text-5xl font-semibold leading-[1.16] tight-cn transition-colors group-hover:text-accent">
            {post.data.title}
          </h3>
          <p class="mt-5 text-sm text-muted leading-relaxed max-w-2xl">
            {post.data.description}
          </p>
          <p class="mt-5 font-mono text-[11px] tracking-wide text-muted">
            <span class="text-accent">{formatDate(post.data.pubDate)}</span>
            <span class="text-faint"> · </span>~{minutes} MIN
            {tags && <span class="text-faint"> · </span>}
            {tags}
          </p>
        </div>
      </div>
    </a>
  )
}

{
  variant === 'card' && (
    <a href={href} class="group flex flex-col" data-reveal style={delay}>
      <span class="font-display italic text-lg text-faint select-none leading-none">
        {cn(index + 1)}
      </span>
      <div class="rule-gold mt-4 w-9 transition-all duration-500 group-hover:w-20" />
      <h3 class="mt-5 font-display text-xl font-semibold leading-snug tight-cn transition-colors group-hover:text-accent">
        {post.data.title}
      </h3>
      <p class="mt-3 font-mono text-[11px] tracking-wide text-muted">
        <span class="text-accent">{formatDate(post.data.pubDate)}</span>
        <span class="text-faint"> · </span>~{minutes} MIN
        {tags && <span class="text-faint"> · </span>}
        {tags}
      </p>
    </a>
  )
}

{
  variant === 'row' && (
    <a
      href={href}
      class="post-row group flex items-center gap-4 py-6 border-b border-line transition-colors"
      data-reveal
      style={delay}
    >
      <div class="min-w-0">
        <h3 class="font-display text-xl font-semibold leading-snug tight-cn transition-colors group-hover:text-accent">
          {post.data.title}
        </h3>
        <p class="mt-2 font-mono text-[11px] text-muted truncate">
          <span class="text-accent">{formatDate(post.data.pubDate)}</span>
          {' · '}
          {tags}
        </p>
      </div>
      <span
        class="ml-auto shrink-0 font-mono text-faint transition group-hover:text-accent group-hover:translate-x-0.5"
        aria-hidden="true"
      >
        →
      </span>
    </a>
  )
}

---
interface Props {
  seed: string;
  class?: string;
}

const { seed, class: cls } = Astro.props;
---

<div class:list={['genart', 'art-frame', 'overflow-hidden', cls]} data-seed={seed}>
  <canvas class="block w-full h-full" aria-hidden="true"></canvas>
</div>

<script>
  import { drawStatic } from '../lib/generative';

  const paint = () => {
    document
      .querySelectorAll<HTMLElement>('.genart:not([data-ready])')
      .forEach((el) => {
        el.dataset.ready = '1';
        const canvas = el.querySelector('canvas');
        if (canvas) drawStatic(canvas, el.dataset.seed || `${Math.random()}`);
      });
  };
  paint();

  let timer: ReturnType<typeof setTimeout> | undefined;
  window.addEventListener('resize', () => {
    clearTimeout(timer);
    timer = setTimeout(() => {
      document
        .querySelectorAll<HTMLElement>('.genart[data-ready]')
        .forEach((el) => {
          delete el.dataset.ready;
        });
      paint();
    }, 200);
  });
</script>

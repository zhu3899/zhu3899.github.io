---
import { SITE } from '../site.config';

const navs = [
  ['/', 'HOME'],
  ['/blog', 'POSTS'],
  ['/archive', 'ARCHIVE'],
  ['/about', 'ABOUT'],
] as const;

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header sticky top-0 z-40 border-b border-line">
  <div class="wrap flex h-14 items-center gap-3 sm:gap-6">
    <a
      href="/"
      class="font-mono text-xs font-bold tracking-tight whitespace-nowrap sm:text-sm"
    >
      <span class="text-aurora">▊{SITE.title}</span><span
        class="text-faint">_</span
      >
    </a>
    <nav
      class="ml-auto flex items-center gap-2 font-mono text-[10px] tracking-[0.06em] sm:gap-5 sm:text-xs sm:tracking-[0.18em]"
      aria-label="主导航"
    >
      {
        navs.map(([href, label]) => (
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'u-link',
              isActive(href) ? 'is-active text-accent' : 'text-muted',
            ]}
          >
            {label}
          </a>
        ))
      }
      <button
        type="button"
        data-search-open
        class="flex items-center gap-1 border border-line rounded-md px-1.5 py-1 text-muted transition-colors hover:border-accent hover:text-accent sm:gap-1.5 sm:px-2"
        aria-label="搜索文章"
      >
        <span>⌕</span><kbd class="hidden sm:inline-block">Ctrl K</kbd>
      </button>
      <button
        type="button"
        data-theme-toggle
        class="w-6 h-6 shrink-0 grid place-items-center border border-line rounded-md text-muted transition-colors hover:border-accent hover:text-accent sm:w-7 sm:h-7"
        aria-label="切换明暗主题"
      >
        <span class="theme-icon-sun hidden">☀</span>
        <span class="theme-icon-moon">☾</span>
      </button>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;

  function syncIcons() {
    const light = root.dataset.theme === 'light';
    document
      .querySelectorAll<HTMLElement>('.theme-icon-sun')
      .forEach((el) => el.classList.toggle('hidden', !light));
    document
      .querySelectorAll<HTMLElement>('.theme-icon-moon')
      .forEach((el) => el.classList.toggle('hidden', light));
  }

  function initHeader() {
    syncIcons();
    document
      .querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')
      .forEach((btn) => {
        if (btn.dataset.themeBound) return;
        btn.dataset.themeBound = '1';
        btn.addEventListener('click', () => {
          const next = root.dataset.theme === 'light' ? 'dark' : 'light';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {}
          syncIcons();
          /* 从 document 派发：会冒泡到 window，document 与 window 上的监听器都能收到 */
          document.dispatchEvent(
            new CustomEvent('theme-change', { detail: next })
          );
        });
      });
  }

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>

---
import { SITE } from '../site.config';

const navs = [
  ['/', 'HOME'],
  ['/blog', 'POSTS'],
  ['/archive', 'ARCHIVE'],
  ['/about', 'ABOUT'],
] as const;

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header sticky top-0 z-40 border-b border-line">
  <div class="wrap flex h-14 items-center gap-4 sm:gap-6">
    <a
      href="/"
      class="font-mono text-sm font-bold tracking-tight whitespace-nowrap"
    >
      <span class="text-accent blink">▊</span>{SITE.title}<span
        class="text-faint">_</span
      >
    </a>
    <nav
      class="ml-auto flex items-center gap-3 font-mono text-[11px] tracking-[0.18em] sm:gap-5 sm:text-xs"
      aria-label="主导航"
    >
      {
        navs.map(([href, label]) => (
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'u-link',
              isActive(href) ? 'is-active text-accent' : 'text-muted',
            ]}
          >
            {label}
          </a>
        ))
      }
      <button
        type="button"
        data-search-open
        class="flex items-center gap-1.5 border border-line rounded-md px-2 py-1 text-muted transition-colors hover:border-accent hover:text-accent"
        aria-label="搜索文章"
      >
        <span>⌕</span><kbd class="hidden sm:inline-block">Ctrl K</kbd>
      </button>
      <button
        type="button"
        data-theme-toggle
        class="w-7 h-7 grid place-items-center border border-line rounded-md text-muted transition-colors hover:border-accent hover:text-accent"
        aria-label="切换明暗主题"
      >
        <span class="theme-icon-sun hidden">☀</span>
        <span class="theme-icon-moon">☾</span>
      </button>
    </nav>
  </div>
</header>

<script>
  const root = document.documentElement;
  const syncIcons = () => {
    const light = root.dataset.theme === 'light';
    document
      .querySelectorAll<HTMLElement>('.theme-icon-sun')
      .forEach((el) => el.classList.toggle('hidden', !light));
    document
      .querySelectorAll<HTMLElement>('.theme-icon-moon')
      .forEach((el) => el.classList.toggle('hidden', light));
  };
  syncIcons();
  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach(
    (btn) =>
      btn.addEventListener('click', () => {
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
        syncIcons();
        window.dispatchEvent(
          new CustomEvent('theme-change', { detail: next })
        );
      })
  );
</script>

---
---

<div class="hero-art" data-hero-canvas>
  <canvas aria-hidden="true"></canvas>
</div>
<div class="hero-vignette"></div>
<div class="hero-fade"></div>

<style>
  .hero-art {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .hero-art canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { startHero } from '../lib/generative';

  let cleanup: (() => void) | null = null;

  function initHero() {
    cleanup?.();
    cleanup = null;
    const host = document.querySelector<HTMLElement>('[data-hero-canvas]');
    if (!host) return;
    const canvas = host.querySelector('canvas');
    if (canvas) cleanup = startHero(canvas);
  }

  initHero();
  document.addEventListener('astro:page-load', initHero);
  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = null;
  });
</script>
